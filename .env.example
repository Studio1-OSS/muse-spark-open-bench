# Your Nebius Token Factory API key. Only needed to run new reviews.
NEBIUS_API_KEY=
NEBIUS_BASE_URL=https://api.tokenfactory.us-north1.nebius.com/v1/
NEBIUS_MODEL=meta-models/muse-spark-open

# Local folder for run records.
DATA_DIR=./data
# Case folders: the merged tree of each PR, about 1.3 GB for all 50. Defaults to data/cases.
REVIEW_CASES_DIR=

# Limits per review and per batch.
MAX_STEPS=40
MAX_OUTPUT_TOKENS=16384
TASK_TIMEOUT_SECONDS=1800
MAX_TASK_COST_USD=5
MAX_BATCH_COST_USD=100

# Public URL of the results page, used for link previews.
SITE_URL=
